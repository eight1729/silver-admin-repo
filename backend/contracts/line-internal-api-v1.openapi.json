        ]
      }
    },
    "/internal/v1/staging-send-readiness:check": {
      "post": {
        "description": "Contract declaration only; no runtime implementation in Phase 1.",
        "operationId": "check_staging_send_readiness_internal_v1_staging_send_readiness_check_post",
