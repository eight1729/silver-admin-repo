            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "LineInternalBearer": []
          }
        ],
        "summary": "Accept Notification Command",
        "tags": [
          "notification-command"
        ]
      }
    },
    "/internal/v1/notification-commands/{command_id}": {
      "get": {
        "description": "Contract declaration only; no runtime implementation in Phase 1.",
        "operationId": "get_notification_result_internal_v1_notification_commands__command_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "command_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Command Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
