            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "LineInternalBearer": []
          }
        ],
        "summary": "Get Notification Result",
        "tags": [
