# Public template only: blank values / {} are placeholders, not deployment-ready.
# Backend and frontend loaders use the repository-root .env.admin file.
# .env.example is a reference; it is not the owner Settings dotenv file.
# Existing process environment takes priority, including explicitly empty values.
# A=REQUIRED_CANONICAL, B=CONDITIONALLY_REQUIRED, C=OPTIONAL_WITH_DEFAULT
# D=PUBLIC_FRONTEND, E=SERVER_SECRET, F=LEGACY_OR_UNUSED_CANDIDATE

# D: Public frontend configuration.
# Set the owner API URL for a separate API origin; blank means same-origin.
# The resolver uses ?? : an empty owner URL suppresses the generic fallback.
# To use the generic fallback, omit the owner variable from file AND process env.
NEXT_PUBLIC_ADMIN_API_BASE_URL=
# NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_ADMIN_SERVICE_ID=
# Google GIS returns an ID Token. This public Web OAuth client ID must equal
# ADMIN_OIDC_AUDIENCE; authorization is determined by persisted Staff DB records.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# C: local is the Settings default, not a production authentication configuration.
# Production requires enabled/configured Staff OIDC; local/development/demo/
# staging/test retain the existing demo authentication path.
APP_ENV=local
# A + E: database connection string; server only.
DATABASE_URL=
# B (default empty): comma-separated browser origins when cross-origin is needed.
ADMIN_CORS_ALLOWED_ORIGINS=
# C: Docker entrypoint process variable (shell default 8080).
# Settings does not load PORT from the owner dotenv into the container process.
PORT=8080

# A + E: incoming LINE -> Admin credential.
# Must match LINE's LINE_ADMIN_INTERNAL_API_BEARER_TOKEN.
ADMIN_INTERNAL_API_BEARER_TOKEN=
# A: JSON service_id -> organization_id; inbound authorization/canonical scope.
ADMIN_INTERNAL_API_SCOPES={}
# A: JSON organization_id -> Current DB center_code; separate from auth scope.
CURRENT_DB_BUSINESS_CENTERS={}
# A for canonical notification runtime: explicit comma-separated owned service IDs.
# Must be in ADMIN_INTERNAL_API_SCOPES; never inferred from all authorized scopes.
ADMIN_NOTIFICATION_RUNNER_SERVICE_IDS=

# A: outgoing Admin -> LINE API URL (HTTPS required in production).
ADMIN_LINE_INTERNAL_API_BASE_URL=
# A + E: must match LINE's LINE_INTERNAL_API_BEARER_TOKEN.
# The two directional credentials are distinct, with no fallback; neither is
# shared with Staff OIDC credentials.
ADMIN_LINE_INTERNAL_API_BEARER_TOKEN=

# B: external business API URL (HTTPS required in production).
# Unset keeps every entrypoint on the Current DB Adapter.
ADMIN_EXTERNAL_BUSINESS_BASE_URL=
# B: ID token audience; unset uses the base URL.
ADMIN_EXTERNAL_BUSINESS_AUDIENCE=

# B: required for production Staff authentication; false is the safe template default.
ADMIN_OIDC_ENABLED=false
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_AUDIENCE=
ADMIN_OIDC_JWKS_URL=
# C: explicit Settings default; an empty value would override this default.
ADMIN_OIDC_ALGORITHMS=RS256

# B: local-only integration; uses Current DB and the real HTTP LINE boundary.
ADMIN_LOCAL_INTEGRATION_MODE=false
# Required when local integration is enabled: JSON service_id -> organization_id.
ADMIN_LOCAL_INTEGRATION_SCOPES={}

# F: retained for historical/local tooling review; not canonical owner settings.
# Generic CORS belongs to legacy config; use ADMIN_CORS_ALLOWED_ORIGINS above.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8082
LOG_LEVEL=
CORS_ALLOWED_ORIGINS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# F + E: server-only service role key; never expose via NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# F + D: no current canonical frontend consumer found.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
