# ============================================================================
# Frontend
# ============================================================================

NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_ADMIN_API_BASE_URL=
NEXT_PUBLIC_ADMIN_SERVICE_ID=
# staging の入口の鍵。ADMIN_STATIC_BEARER_TOKEN と同じ値を入れる
NEXT_PUBLIC_ADMIN_STATIC_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# Backend
# ============================================================================

APP_ENV=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8082
PORT=8082
DATABASE_URL=
LOG_LEVEL=
CORS_ALLOWED_ORIGINS=
ADMIN_CORS_ALLOWED_ORIGINS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_LINE_INTERNAL_API_BASE_URL=
ADMIN_LINE_INTERNAL_API_BEARER_TOKEN=
ADMIN_LOCAL_INTEGRATION_MODE=false
ADMIN_LOCAL_INTEGRATION_SCOPES={}
ADMIN_OIDC_ENABLED=false
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_AUDIENCE=
ADMIN_OIDC_JWKS_URL=
ADMIN_OIDC_ALGORITHMS=

# ----------------------------------------------------------------------------
# 外部業務システム（ic）接続 — staging / production で使う
# ----------------------------------------------------------------------------
# ic 業務 API の URL。ID トークンの audience にもなる（production は https のみ）
ADMIN_EXTERNAL_BUSINESS_BASE_URL=
# service_id -> organization_id の対応。例 {"silver-sumida":"sandbox"}
ADMIN_EXTERNAL_BUSINESS_SCOPES={}

# 入口の鍵。APP_ENV=staging は全リクエストを認証なしの Admin ロールとして扱うため、
# staging / production ではこれが無いと起動しない。値は Secret Manager に置く
ADMIN_STATIC_BEARER_TOKEN=
# LINE 窓口 -> Admin（初回連携の本人照合）。職員用とは別のトークン。Secret Manager に置く
ADMIN_LINE_INBOUND_BEARER_TOKEN=
# POST /admin/demo/reset は台帳を全消しする。staging / production は既定で無効
ADMIN_ALLOW_DEMO_RESET=false

# Cloud Scheduler -> Admin（配信結果の突き合わせ）。両方揃って初めて受け付ける
ADMIN_RECONCILE_AUDIENCE=
ADMIN_RECONCILE_CALLER=
