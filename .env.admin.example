# Local owner dotenv template; never put secrets in NEXT_PUBLIC_*.
# Copy manually to repository-root .env.admin for local development only.
# Select APP_ENV=local in the launching process BEFORE Backend/Frontend starts.
# APP_ENV=production must come from Cloud process env; no dotenv fallback.
# Both runtimes require explicit local/production; NODE_ENV is independent.
APP_ENV=local

# Public Frontend build-time configuration (Node 22 / npm).
# Required nonempty API URL. Empty is an error, NOT same-origin.
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://127.0.0.1:8082
# Optional compatibility fallback, only if the owner variable is absent entirely.
# NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Select the service allowed by persisted Staff permissions.
NEXT_PUBLIC_ADMIN_SERVICE_ID=

# Backend: Python 3.12, PostgreSQL development DB for local; server only.
DATABASE_URL=
# Exact browser origins. localhost and 127.0.0.1 are distinct.
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Canonical authorization: service_id -> organization_id (JSON).
ADMIN_INTERNAL_API_SCOPES={}
# Explicit runner ownership; comma-separated subset of the canonical scopes.
ADMIN_NOTIFICATION_RUNNER_SERVICE_IDS=
# Current DB business mapping: organization_id -> center_code (JSON).
CURRENT_DB_BUSINESS_CENTERS={}

# Admin -> LINE; HTTPS required in production.
# Local standard: https://silver-backend.ngrok.app (human starts the tunnel).
ADMIN_LINE_INTERNAL_API_BASE_URL=https://silver-backend.ngrok.app
# Server secret: matches local LINE_INTERNAL_API_BEARER_TOKEN on LINE.
ADMIN_LINE_INTERNAL_API_BEARER_TOKEN=
# Separate incoming LINE -> Admin server secret; never substitute the above.
# Matches LINE_ADMIN_INTERNAL_API_BEARER_TOKEN on LINE.
ADMIN_INTERNAL_API_BEARER_TOKEN=

# Google Staff OIDC required in BOTH environments. No Demo authentication.
ADMIN_OIDC_ENABLED=true
ADMIN_OIDC_ISSUER=
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID.
ADMIN_OIDC_AUDIENCE=
ADMIN_OIDC_JWKS_URL=
ADMIN_OIDC_ALGORITHMS=RS256

# Optional external business HTTP provider; blank keeps the real Current DB.
# Not required for local. HTTPS required in production; Google service ID token
# credentials must be provided separately if using this provider.
ADMIN_EXTERNAL_BUSINESS_BASE_URL=
# Optional ID token audience; blank defaults to the business base URL.
ADMIN_EXTERNAL_BUSINESS_AUDIENCE=

# Process-only startup settings (not imported from this file):
# Backend local: PYTHONPATH=backend; explicit port 8082 in SelectorEventLoop docs.
# Frontend local: npm run dev -- -p 3001
# Docker: PORT supplied by Cloud (default 8080).
# Local selected recipient limit is fixed at 10 in Backend code.
# staging_live is an unchanged LINE local-safety wire label, not APP_ENV.
